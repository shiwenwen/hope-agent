{
  "name": "hope-agent",
  "private": true,
  "version": "0.66.0",
  "license": "MIT",
  "author": "shiwenwen",
  "homepage": "https://github.com/shiwenwen/hope-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiwenwen/hope-agent.git"
  },
  "bugs": {
    "url": "https://github.com/shiwenwen/hope-agent/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820",
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/select-desktop-dev.mjs",
    "dev:desktop": "pnpm exec tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:desktop:browser": "pnpm dev:browser-host && pnpm dev:desktop",
    "dev:desktop:eval": "pnpm dev:eval-sidecar && pnpm dev:desktop",
    "dev:desktop:full": "pnpm dev:browser-host && pnpm dev:eval-sidecar && pnpm dev:desktop",
    "build": "tsc -b --pretty false && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "memory:smoke": "bash scripts/memory-smoke-test.sh",
    "memory:benchmark": "bash scripts/memory-scale-benchmark.sh",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css}'",
    "i18n:check": "node scripts/sync-i18n.mjs --check && node scripts/audit-i18n-quality.mjs --locales ar,es,ja,ko,ms,pt,ru,tr,vi,zh,zh-TW --source src --all --fail-on-same",
    "i18n:apply": "node scripts/sync-i18n.mjs --apply",
    "i18n:audit": "node scripts/audit-i18n-quality.mjs",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css}'",
    "preview": "vite preview",
    "sync:version": "node scripts/sync-version.mjs",
    "analyze:crate-deps": "node scripts/analyze-crate-deps.mjs",
    "check:agent-kernel-boundaries": "node scripts/check-agent-kernel-boundaries.mjs",
    "prepare:browser-host": "node scripts/prepare-browser-host.mjs",
    "dev:browser-host": "node scripts/prepare-browser-host.mjs --dev",
    "check:eval-internal": "cargo check -p ha-core -p ha-eval-runtime -p ha-improve --tests --features ha-core/eval-internal-tests,ha-eval-runtime/eval-internal-tests,ha-improve/eval-internal-tests --locked",
    "prepare:eval-sidecar": "node scripts/prepare-eval-sidecar.mjs",
    "dev:eval-sidecar": "node scripts/prepare-eval-sidecar.mjs --dev",
    "release:verify": "node scripts/verify-release-version.mjs",
    "check:release-paths": "node scripts/check-release-paths.mjs",
    "check:docs-parity": "node scripts/check-docs-parity.mjs",
    "chrome:extension:package": "pnpm --dir extensions/chrome package:webstore",
    "chrome:extension:smoke-pages": "pnpm --dir extensions/chrome smoke-pages",
    "chrome:extension:smoke-pages:check": "pnpm --dir extensions/chrome smoke-pages:check",
    "chrome:extension:verify": "pnpm --dir extensions/chrome verify:webstore",
    "fetch:vcredist": "node scripts/fetch-vcredist.mjs",
    "tauri": "tauri",
    "version": "node scripts/sync-version.mjs",
    "prepare": "husky && node scripts/setup-ssh-keepalive.mjs",
    "postinstall": "node scripts/patch-codemirror-edit-context.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@lezer/highlight": "^1.2.5",
    "@lobehub/fluent-emoji": "^4.1.1",
    "@lobehub/icons": "^5.23.0",
    "@lobehub/ui": "^5.58.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "2.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.6",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "es-toolkit": "^1.52.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.4",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "mp4-muxer": "^5.2.2",
    "parse5": "^8.0.1",
    "pptxviewjs": "^1.1.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^5.5.6",
    "react-force-graph-2d": "^1.29.2",
    "react-i18next": "^17.0.16",
    "recharts": "^3.10.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/vscode-icons": "^1.2.88",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "mediabunny": "1.61.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.5",
    "yaml": "2.9.1"
  }
}
