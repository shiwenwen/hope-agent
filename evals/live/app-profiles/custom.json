{
  "schemaVersion": "eval-app-profile.v1",
  "id": "custom",
  "version": "1.4.0",
  "title": "Custom diagnosis",
  "description": "A user-selected subset of all registered Hope Core cases and arms with bounded repetitions.",
  "baseTier": "monthly",
  "suites": [
    {
      "suiteId": "hope-core-orchestration",
      "caseTags": [
        "smoke_monthly"
      ]
    }
  ],
  "allowedArms": [
    "control",
    "faulted",
    "team_full_control",
    "team_full_faulted",
    "single_agent_compute_matched_control",
    "single_agent_compute_matched_faulted"
  ],
  "armMode": "all_allowed",
  "defaultRepetitions": 1,
  "useSuiteRepetitions": false,
  "maxTrials": 500,
  "maxModels": 4,
  "maxConcurrency": 500,
  "defaultConcurrency": 4,
  "maxCostUsd": 1000000,
  "defaultCostUsd": 100,
  "budgetMode": "user_configurable",
  "allowCustom": true
}
