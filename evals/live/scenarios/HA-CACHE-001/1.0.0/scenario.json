{
  "schemaVersion": "live-agent-scenario.v1",
  "id": "HA-CACHE-001",
  "version": "1.0.0",
  "title": "缓存复用、工具与摘要的分阶段基准",
  "capabilities": [
    "prompt_cache",
    "context_compaction",
    "tool"
  ],
  "businessDomains": [
    "context_management",
    "performance_diagnostics"
  ],
  "subject": {
    "entrypoint": "server",
    "driver": "chat_task",
    "configProfile": "eval-safe-cache-benchmark-v1"
  },
  "environment": {
    "runnerClass": "dedicated_linux",
    "assets": [
      "fixtures/tool-a.txt",
      "fixtures/tool-b.txt",
      "fixtures/tool-final.txt"
    ],
    "services": [],
    "controlledClock": false
  },
  "task": {
    "promptPath": "fixtures/task.zh-CN.md",
    "hiddenTruthPath": "verifiers/truth.json",
    "successSummary": "逐阶段恢复合成事实，观测历史预热、尾部变化、工具循环和摘要前后的真实用量与延迟"
  },
  "userSimulator": {
    "kind": "scripted_fsm",
    "scriptPath": "fixtures/turns.json",
    "maxTurns": 12
  },
  "milestones": [
    {
      "id": "scripted_compact_context_1",
      "requires": [],
      "anyOf": [],
      "weight": 0.4,
      "blocking": true
    },
    {
      "id": "facts_preserved",
      "requires": [
        "scripted_compact_context_1"
      ],
      "anyOf": [],
      "verifier": "facts_preserved",
      "weight": 0.5,
      "blocking": true
    },
    {
      "id": "trace_terminal",
      "requires": [
        "facts_preserved"
      ],
      "anyOf": [],
      "verifier": "trace_closed",
      "weight": 0.1,
      "blocking": true
    }
  ],
  "faults": [],
  "verifiers": [
    {
      "id": "facts_preserved",
      "kind": "http_assertion",
      "handler": "response_json_exact",
      "configPath": "verifiers/expected-response.json",
      "blocking": true,
      "timeoutSeconds": 30
    },
    {
      "id": "trace_closed",
      "kind": "trace_assertion",
      "handler": "trace_closed",
      "blocking": true,
      "timeoutSeconds": 30
    }
  ],
  "invariants": [
    {
      "id": "no_orphan_children",
      "kind": "parent_child_closed",
      "blocking": true
    },
    {
      "id": "root_closed_once",
      "kind": "exactly_once",
      "event": "session.root.closed",
      "key": "sessionId",
      "blocking": true
    }
  ],
  "artifacts": [],
  "budgets": {
    "maxWallSeconds": 900,
    "maxModelCalls": 24,
    "maxInputTokens": 600000,
    "maxOutputTokens": 16000,
    "maxCostUsd": 5,
    "maxToolCalls": 8,
    "maxAgents": 1,
    "maxConcurrency": 1
  },
  "network": {
    "policy": "provider_only",
    "allow": []
  },
  "privacy": {
    "classification": "synthetic",
    "redact": [
      "authorization",
      "api_key",
      "cookie"
    ],
    "rawTraceRetentionDays": 14
  },
  "cadence": [
    "nightly"
  ]
}
